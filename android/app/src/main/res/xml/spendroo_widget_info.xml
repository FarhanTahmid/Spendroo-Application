<?xml version="1.0" encoding="utf-8"?>
<!-- The Spendroo home-screen widget (com.spendroo.app.widget.SpendrooWidget).
     Opens at 4x2 and resizes from 2x1 to as big as the launcher allows; each size has its layout (WidgetSize).
     The half-hourly update is a safety net for a new day; the app also schedules one at each midnight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="56dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="56dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewImage="@drawable/splash_mark"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
