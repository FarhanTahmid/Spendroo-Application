<?xml version="1.0" encoding="utf-8"?>
<!-- The business card in the dark theme: deeper green, with a faint edge so it holds on a black wallpaper -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="315"
        android:endColor="#FF0D3D34"
        android:startColor="#FF06221D"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
