<?xml version="1.0" encoding="utf-8"?>
<!-- The cashbook widget (com.spendroo.app.widget.business.CashbookWidget).
     The picker asks what it shows when it is placed, and again from Reconfigure. Sizes as the personal widget (BizSize). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.spendroo.app.widget.business.WidgetPickerActivity"
    android:description="@string/widget_book_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="56dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="56dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewImage="@drawable/splash_mark"
    android:previewLayout="@layout/widget_book_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
